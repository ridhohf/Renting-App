generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  TENANT
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum AdjustmentType {
  NOMINAL
  PERCENTAGE
}

enum OrderStatus {
  WAITING_PAYMENT
  WAITING_CONFIRMATION
  PROCESSED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  MANUAL_TRANSFER
  PAYMENT_GATEWAY
}

enum CancelledBy {
  USER
  TENANT
  SYSTEM
}

model User {
  id                      Int          @id @default(autoincrement())
  email                   String       @unique
  passwordHash            String?
  name                    String
  role                    Role
  avatarUrl               String?
  isVerified              Boolean      @default(false)
  verificationToken       String?
  verificationTokenExpiry DateTime?
  resetToken              String?
  resetTokenExpiry        DateTime?
  provider                AuthProvider @default(EMAIL)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  properties Property[]
  categories PropertyCategory[]
  orders     Order[]
  reviews    Review[]

  @@map("users")
}

model PropertyCategory {
  id        Int      @id @default(autoincrement())
  name      String
  tenantId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     User       @relation(fields: [tenantId], references: [id])
  properties Property[]

  @@map("property_categories")
}

model Property {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  categoryId  Int
  name        String
  slug        String   @unique
  description String
  city        String
  province    String
  address     String
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   User             @relation(fields: [tenantId], references: [id])
  category PropertyCategory @relation(fields: [categoryId], references: [id])
  images   PropertyImage[]
  rooms    Room[]
  orders   Order[]
  reviews  Review[]

  @@map("properties")
}

model PropertyImage {
  id         Int      @id @default(autoincrement())
  propertyId Int
  imageUrl   String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_images")
}

model Room {
  id          Int      @id @default(autoincrement())
  propertyId  Int
  name        String
  description String
  basePrice   Decimal  @db.Decimal(12, 2)
  capacity    Int
  totalUnits  Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property         Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  images           RoomImage[]
  peakSeasonRates  PeakSeasonRate[]
  unavailabilities RoomUnavailability[]
  orders           Order[]

  @@map("rooms")
}

model RoomImage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("room_images")
}

model PeakSeasonRate {
  id              Int            @id @default(autoincrement())
  roomId          Int
  startDate       DateTime       @db.Date
  endDate         DateTime       @db.Date
  adjustmentType  AdjustmentType
  adjustmentValue Decimal        @db.Decimal(12, 2)
  reason          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("peak_season_rates")
}

model RoomUnavailability {
  id        Int      @id @default(autoincrement())
  roomId    Int
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("room_unavailabilities")
}

model Order {
  id                     Int            @id @default(autoincrement())
  orderNumber            String         @unique
  userId                 Int
  propertyId             Int
  roomId                 Int
  checkInDate            DateTime       @db.Date
  checkOutDate           DateTime       @db.Date
  guestCount             Int
  totalNights            Int
  totalAmount            Decimal        @db.Decimal(12, 2)
  status                 OrderStatus    @default(WAITING_PAYMENT)
  paymentMethod          PaymentMethod?
  paymentProofUrl        String?
  paymentProofUploadedAt DateTime?
  expiresAt              DateTime
  cancelledBy            CancelledBy?
  cancelReason           String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])
  review   Review?

  @@map("orders")
}

model Review {
  id         Int       @id @default(autoincrement())
  orderId    Int       @unique
  userId     Int
  propertyId Int
  rating     Int
  comment    String
  reply      String?
  repliedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  order    Order    @relation(fields: [orderId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@map("reviews")
}
